# Must use the docker-compose service name `postgres` as the host — never localhost
# inside a container (localhost would point at the backend container itself).
DATABASE_URL=postgresql://bete_user:changeme@postgres:5432/bete_db

PORT=4000
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Mirrored from root .env for documentation / local tooling clarity
POSTGRES_USER=bete_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bete_db

# Prisma seed (npm run docker:seed) — local-dev defaults if unset
# SEED_ADMIN_EMAIL=admin@bete.local
# SEED_ADMIN_PHONE=0911000000
# SEED_ADMIN_PASSWORD=   # if unset, a random password is printed on first create
# SEED_DEMO_DATA=false   # set true to seed demo sellers + LIVE listings

# SMS (optional — blank / unset uses ConsoleSmsProvider which logs OTPs)
# Set SMS_PROVIDER=geezsms and SMS_API_KEY to send real OTPs (GeezSMS account required).
# SMS_PROVIDER=geezsms
# SMS_API_URL=https://api.geezsms.com/api/v1/sms/send
# SMS_API_KEY=                 # from https://geezsms.com/#/api
# SMS_SENDER_ID=               # optional GeezSMS shortcode_id

# Email (optional — blank / unset uses ConsoleEmailProvider which logs instead of sending)
# EMAIL_PROVIDER=        # e.g. resend — leave blank for console logging
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=    # e.g. Bete <noreply@yourdomain.com>

# Public web origin for password-reset email links (defaults to CORS_ORIGIN)
# FRONTEND_URL=http://localhost:3000

# OpenAI (optional — blank / unset disables POST /api/v1/ai/* with a clear 502)
# OPENAI_API_KEY=

# S3 / MinIO (local docker-compose uses service hostname `minio`)
S3_ENDPOINT=http://minio:9000
# Browser-reachable host used to sign presigned URLs (the browser cannot resolve `minio`)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password123
S3_BUCKET=bete
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=http://localhost:9000/bete/public
