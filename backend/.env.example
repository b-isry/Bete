# Must use the docker-compose service name `postgres` as the host — never localhost
# inside a container (localhost would point at the backend container itself).
DATABASE_URL=postgresql://bete_user:changeme@postgres:5432/bete_db

PORT=4000
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Mirrored from root .env for documentation / local tooling clarity
POSTGRES_USER=bete_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bete_db
