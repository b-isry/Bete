# Public API base used by the Next.js app (SWR / fetch in the browser).
# Host-side / browser: http://localhost:4000/api/v1
# Docker network (server-only): http://backend:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional — Footer social icons render only when set.
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_handle
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your_page
