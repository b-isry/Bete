  "content": {
    "eyebrow": "Bete",
    "about": {
      "title": "Waa'ee Bete",
      "p1": "Bete gabaa qabeenya dhaabaa Itoophiyaa kan bitattootaa fi gurgurtootaaf gatii ifa ta'e ETB keessatti, gurgurtoota mirkanaa'an, fi beeksisota itti gaafatamummaa qaban barbaadaniif qophaa'e dha.",
      "p2": "Beeksisni haaraa ykn gulaalame hundi \"Eegaa jira\" jedhamee jalqaba. Qabeenyi hojiirra ga'uu dura bulchitoonni mallattoo sakatta'iinsa AI dursaa ilaalu — AI ofumaan hin mirkaneessu yookaan hin kuffisu.",
      "p3": "Marsaa keenya keessatti fi maqaa magaalaa ykn garee keessatti Amaariffa, Afaan Oromoo, Tigrinya, Soomaalii, fi Ingiliffa ni deeggarra."
    },
    "help": {
      "title": "Gargaarsa",
      "p1": "Hojiiwwan Bete irratti yeroo baay'ee raawwataman kanaa jalqabaa.",
      "p2": "Rakkoo herrega keessaniif, Giddugala Deeggarsaa irraa haasaa deeggarsaa banaa.",
      "support": "Deeggarsa Qunnamaa",
      "safety": "Gorsa Nageenyaa",
      "post": "Beeksisa Maxxansi"
    },
    "safety": {
      "title": "Nageenya",
      "intro": "Daldala hunda akkuma yoo alaan hojjettan of eeggannoo qabaadhaa. Amaloonni kunneen bitattootaa fi gurgurtoota Bete irratti nageenya isaanii eegu.",
      "rule1": "Qabeenya utuu ijaan hin argin dura hin kaffalinaa.",
      "rule2": "Bakka ifaa fi ummataa keessatti walitti dhufaa, ykn nama waliin qabaadhaa.",
      "rule3": "Utuu hin kaffalin dura sanadoota abbummaa akka isinitti agarsiisan gaafadhaa.",
      "rule4": "Odeeffannoo faayinaansii Bete alatti qooduu irra ergaa app keessaa fayyadamuu filadhaa.",
      "outro": "Wanti dogoggora ta'e yoo isinitti dhaga'ame, walgahicha dhiisaa, beeksisa sana fuula qabeenyaa irraa gabaasaa."
    },
    "terms": {
      "title": "Waliigaltee Fayyadamaa",
      "p1": "Bete fayyadamuun keessan odeeffannoo beeksisaa sirrii akka maxxansitanii fi beeksisni \"Hojiirra jira\" ta'ee osoo jiruu qunnamtiin akka argamu waliigaltan.",
      "p2": "Beeksisonni yeroo seera gabaa cabsan ykn gabaasa hin furamne walitti qaban REJECTED, REMOVED, ykn AUTO_HIDDEN ta'uu danda'u.",
      "p3": "Mirkaneessi gurgurtuu gita irraa adda dha: herregoota gurgurtuu haallisaanii VERIFIED ta'e qofa Gurgurtuu Mirkanaa'e jedhamanii mul'atu.",
      "p4": "Bete maallaqa hin qabatu. Kaffaltiin gama lamaan gidduu jiru itti gaafatamummaa isaanii ta'ee itti fufa."
    },
    "privacy": {
      "title": "Dhuunfaa",
      "p1": "Bete gabaa hojjechiisuuf odeeffannoo herregaa isin kennitan — maqaa, bilbila, imeelii, fi qabiyyee beeksisaa — ni walitti qabata.",
      "p2": "Lakkoofsi ilaalchaa beeksisa, furtuu daawwataa, fi guyyaa UTC'tiin adda baafamee ni qabama. Odeeffannoo dhuunfaa gara sadaffaatti hin gurgurru.",
      "p3": "Herregootaa fi beeksisonni salphaatti haqaman hanga to'annoo fi dirqama seeraatiif barbaachiseef qofa ni turfamu."
    },
    "contact": {
      "title": "Qunnamtii",
