# PostgreSQL (used by docker-compose `postgres` service)
POSTGRES_USER=bete_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bete_db

# Shared secrets / app config (also documented in backend/.env.example)
DATABASE_URL=postgresql://bete_user:changeme@postgres:5432/bete_db
PORT=4000
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Frontend (browser) API base — also set in frontend/.env.local and docker-compose
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
